# Production variables for docker-compose.prod.yml.
# In Portainer: Stack → Environment variables (paste these, filled in, or
# use "Load variables from .env file"). Never commit real values.
# Generate secrets with the commands in the comments.

# --- Hostnames (single-level, so the *.ssuniverse.dev wildcard covers them).
# Derived from these: FRONTEND_URL, MINIO_PUBLIC_ENDPOINT, VITE_API_URL.
# The dashboard bakes API_HOST in at build time: change it -> redeploy.
DASHBOARD_HOST=dsl.ssuniverse.dev
API_HOST=dsl-api.ssuniverse.dev
MEDIA_HOST=dsl-media.ssuniverse.dev

# --- Data on the host (absolute path; dsl-data-init creates it on deploy).
DSL_DATA_DIR=/srv/dsl
DSL_UID=1000
DSL_GID=1000

# --- MongoDB. ROOT_* only take effect when ${DSL_DATA_DIR}/mongo is empty.
# Use hex secrets: the app password goes into a URI unescaped.
MONGO_ROOT_USER=root
# openssl rand -hex 32
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=dsl_app
# openssl rand -hex 32
MONGO_APP_PASSWORD=

# --- Backend.
# openssl rand -base64 48
JWT_SECRET=

# --- MinIO. ROOT_* administers the store; ACCESS/SECRET is the backend's
# bucket-scoped user, created by dsl-minio-init.
MINIO_ROOT_USER=dsl-minio-root
# openssl rand -hex 32
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=dsl-backend
# openssl rand -hex 32
MINIO_SECRET_KEY=
MINIO_BUCKET=dsl-media
MINIO_REGION=us-east-1
